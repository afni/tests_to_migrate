#!/bin/bash

# [PDL: May 29, 2024]  Demo for clipping planes
#
# Runs from ~/abin
#
# Usage: @DriveSumaClippingPlanes <Path to executable>
#
# Example: ./@DriveSumaClippingPlanes "~/afniDev/afni/build/src/SUMA"
#
# If the path to the executable is not specified, the suma, in the default
# search path, is used.


if [ "$#" -ne 0 ]; then
        export PATH=$1:$PATH
fi


set HelpOpt = ''
echo "$1" | \grep -w -E  \
      '\-h_txt|\-h_spx|\-h_aspx|\-h_raw|\-help|\-h' >& /dev/null

# Test function
AlphaTestFunction() {

        directory=$1
        arguments=$2

	if [ "$#" -gt 2 ]; then
             export stepSize=$3
	else
	     export stepSize="="
        fi

	if [ "$#" -gt 3 ]; then
             export numSteps=$4
	else
	     export numSteps=10
        fi

        set l = `prompt_user -pause \
        '@DriveSuma \n\
            #Make sure no current SUMA is running, then press OK'`

        # Clipping planes
        set l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK for clipping planes'`

        cd $directory
        suma $arguments &

        # Turn on clipping plane mode
	DriveSuma -com  viewer_cont -key ctrl+C

	# Set step size
	#echo "Set step size"
	#if ["$stepSize" == "+" ]; then
	#    for i in $(seq 1 10);
        #    do
        #        DriveSuma -com  viewer_cont -key S
        #    done
	#fi

        # Activate plane 4
        set l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK to acivate plane 4'`
	DriveSuma -com  viewer_cont -key 4

        # Scroll in
	echo "Scroll in"
        set l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK to scroll in'`
	for i in $(seq 1 $numSteps);
	do
            DriveSuma -com  viewer_cont -key S
        done

        # Scroll out
        l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK to scroll out'`
	for i in $(seq 1 3);
	do
            DriveSuma -com  viewer_cont -key s
        done

        # Make clippnig plane invisible
        l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK to make plane 4 active but invisible'`
	DriveSuma -com  viewer_cont -key C

        # Scroll in
        l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK to scroll in'`
	for i in $(seq 1 3);
	do
            DriveSuma -com  viewer_cont -key S
        done

        # Scroll out
        l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK to scroll out'`
	for i in $(seq 1 3);
	do
            DriveSuma -com  viewer_cont -key s
        done

        l = `prompt_user -pause \
                '@DriveSuma \n\
                Press OK for next demo'`
        echo "++++++++++++++++++++++++  Next demo"
        DriveSuma -com kill_suma
}

AlphaTestFunction "$HOME/AFNI_data6/FT_analysis/FT/SUMA" \
	"-spec std.60.FT_lh.spec"

AlphaTestFunction "$HOME/trk3" \
	"-tract trk3_000.niml.tract" "+" 30




